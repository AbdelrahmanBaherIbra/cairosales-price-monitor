# Cairo Sales Supabase project (project ref: tepyapssrofxuwonqepv)
# Direct Postgres connection string (server-only). Use the Supabase connection
# POOLER string (port 6543) for serverless/Vercel. Dashboard: Project Settings
# > Database > Connection string > "Transaction" pooler.
# The price_monitor schema is reached over this connection, not the REST API.
#
# NOTE: the pooler HOSTNAME is not stable. Supabase moved this project from
# aws-0-eu-central-1 to aws-1-eu-central-1; the old host now fails to connect
# with "tenant/user postgres.<ref> not found", which takes down the app and the
# scraper at the same time. Always copy the current string from the dashboard
# rather than reusing an old one, and update BOTH places it is stored:
# Vercel project env vars, and the GitHub Actions SUPABASE_DB_URL secret.
SUPABASE_DB_URL=postgresql://postgres.tepyapssrofxuwonqepv:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Protects the daily cron endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# Optional: third-party scraping API for the blockers (Amazon / Noon / Jumia).
# Leave empty to skip those competitors until you add a key.
SCRAPER_API_KEY=
SCRAPER_API_PROVIDER=zyte
